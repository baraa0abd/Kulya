# Copy to .env (never commit .env). All values here are placeholders.

# --- Django ---------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins of the frontend, when it is served from another origin.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Behind an HTTPS proxy in production: true / 31536000.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- Database and broker ----------------------------------------------------------------------
# Local development against `docker compose up -d db redis` (loopback ports 5433 / 6380).
DATABASE_URL=postgres://copilot:copilot-dev-only@127.0.0.1:5433/copilot
POSTGRES_PASSWORD=copilot-dev-only
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
# true = run AI jobs inline (no worker needed). docker compose sets false and runs a worker.
CELERY_TASK_ALWAYS_EAGER=true

# --- AI ---------------------------------------------------------------------------------------
# mock = offline template provider (tests, demo). anthropic = Claude API (needs the key below).
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=45
ANTHROPIC_API_KEY=

# --- Demo -------------------------------------------------------------------------------------
# true = synthetic demonstration deployment.
DEMO_MODE=true
# Password given to every seeded demo account by `manage.py seed_demo`.
DEMO_PASSWORD=
