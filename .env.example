# Copy to .env (never commit .env).

# PostgreSQL 16 in docker; leave empty to fall back to SQLite for local quick runs.
DATABASE_URL=postgres://kulya:kulya@localhost:5432/kulya
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false

# mock = offline fixtures (tests, offline demo). anthropic = real model.
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=

# true = refuse to start if any Patient has is_synthetic=false.
DEMO_MODE=true
# Password for the seeded demo users (nurse1, doctor1, patient_syn001).
DEMO_PASSWORD=
