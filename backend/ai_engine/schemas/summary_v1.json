{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentences"],
  "properties": {
    "sentences": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text_ar", "citations"],
        "properties": {
          "text_ar": {"type": "string", "minLength": 1, "maxLength": 500},
          "citations": {"type": "array", "maxItems": 20, "items": {"type": "integer"}}
        }
      }
    }
  }
}
