{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "copilot-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["backend/manage.py", "runserver", "8000", "--noreload"],
      "port": 8000
    },
    {
      "name": "copilot-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
